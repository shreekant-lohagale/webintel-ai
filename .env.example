MONGODB_URI=mongodb://webintel_dev:webintel_local_only@127.0.0.1:27017/?authSource=admin
MONGODB_DATABASE=webintel_ai

# API runtime. Keep debug off and interactive docs disabled in production.
WEBINTEL_API_TITLE=WebIntel AI API
WEBINTEL_API_VERSION=0.1.0
WEBINTEL_API_DEBUG=false
WEBINTEL_API_DOCS_ENABLED=true
WEBINTEL_LOG_LEVEL=INFO

# Local Vite development proxy; never use localhost for a hosted frontend.
WEBINTEL_API_PROXY_TARGET=http://127.0.0.1:8000
WEBINTEL_BUILD_ID=development

# Server-side secrets. Replace locally; never prefix these with VITE_.
GROQ_API_KEY=
WEBINTEL_API_KEY=

# Retrieval and inference configuration.
WEBINTEL_RAG_MODEL=openai/gpt-oss-120b
WEBINTEL_RAG_MIN_COSINE=0.25
WEBINTEL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
WEBINTEL_EMBEDDING_REVISION=main
WEBINTEL_CHUNK_WORDS=120
WEBINTEL_CHUNK_OVERLAP=25
WEBINTEL_EMBEDDING_BATCH_SIZE=32

# Abuse and workload controls. In-memory limits are development safeguards only.
WEBINTEL_RATE_LIMIT_PER_MINUTE=10
WEBINTEL_INFERENCE_RATE_LIMIT_PER_MINUTE=5
WEBINTEL_MAX_QUEUED_JOBS=25
WEBINTEL_CRAWL_TIMEOUT_SECONDS=120

# Comma-separated crawl allowlist. Production crawl submissions must be authenticated.
WEBINTEL_ALLOWED_HOSTS=
WEBINTEL_RETRY_BASE_DELAY=1
WEBINTEL_RETRY_MAX_DELAY=10
